# ==============================================================================
# AI Sales & CRM Operating System — Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=AI Sales & CRM Operating System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL 16)
# If PostgreSQL is unavailable, SQLite fallback will automatically be used in development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm_leads
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Celery Task Queue
# If Redis is unavailable, synchronous in-process task execution will be used as fallback.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI & Reasoning Providers (Fault-Tolerant: Fallback to Heuristic NLP if missing)
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter API (Alternative multi-model LLM router)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ------------------------------------------------------------------------------
# Lead Discovery & Scraping Providers
# ------------------------------------------------------------------------------
# SerpAPI - Google Maps & Web Search
SEARCH_API_PROVIDER=serpapi
SEARCH_API_KEY=
SERPAPI_API_KEY=
SEARCH_API_TIMEOUT=30

# Apify Actor Platform (Google Maps Scraper Actor)
APIFY_API_TOKEN=
APIFY_MAPS_ACTOR_ID=nwua9Gu5YrADL7ZDj
APIFY_REQUEST_TIMEOUT=300

# Firecrawl - Deep Web Scraping & Content Extraction
FIRECRAWL_API_KEY=
FIRECRAWL_REQUEST_TIMEOUT=60
FIRECRAWL_MAX_PAGES=5

# Outscraper (Optional alternative discovery)
OUTSCRAPER_API_KEY=
OUTSCRAPER_REQUEST_TIMEOUT=300

# Google Places API (Optional official API)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REQUEST_TIMEOUT=30

# ------------------------------------------------------------------------------
# Communication & Outreach Integrations
# ------------------------------------------------------------------------------
# Gmail OAuth 2.0 (Official Google Workspace integration)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GMAIL_SENDER_EMAIL=

# WhatsApp Business Cloud API (Official Meta Developer Platform)
# Setup at: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=crm_whatsapp_verify_token_default
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# AI Lead Qualification ICP Weights (Sum must equal 1.0)
# ------------------------------------------------------------------------------
ICP_WEIGHT_FIT=0.25
ICP_WEIGHT_PAIN=0.25
ICP_WEIGHT_TIMING=0.20
ICP_WEIGHT_REACHABILITY=0.15
ICP_WEIGHT_EVIDENCE=0.15

# ------------------------------------------------------------------------------
# Security, Access & SSRF Protection
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-production-secret-key-32-chars-min
ADMIN_API_KEY=dev-admin-key-ai-sales-crm
AUTH_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting & Crawl Safeguards
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
MAX_RESULTS_PER_JOB=500
DEFAULT_SEARCH_RADIUS_KM=10
JOB_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=1
MAX_RETRIES=3
USER_AGENT=AI-Sales-CRM-Bot/2.0

# SSRF Protection
ALLOW_PRIVATE_IPS=false
BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3-Compatible Asset Storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=crm-creatives
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Social Media Automation (Official Developer APIs)
# ------------------------------------------------------------------------------
# Instagram Content Publishing (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Pages API
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# X (Twitter) Developer API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_URN=
