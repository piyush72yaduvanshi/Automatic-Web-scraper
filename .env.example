# Application Configuration
APP_NAME=CRM Lead Discovery
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm_leads
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Provider API Keys
# Apify - Business Discovery from Google Maps
# Get your API key from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Find actor IDs at: https://apify.com/store
APIFY_MAPS_ACTOR_ID=nwua9Gu5YrADL7ZDj
APIFY_REQUEST_TIMEOUT=300

# Outscraper - Alternative Business Discovery
# Get your API key from: https://outscraper.com/api-access/
OUTSCRAPER_API_KEY=
OUTSCRAPER_REQUEST_TIMEOUT=300

# Google Places API - Official Google Business Data
# Get your API key from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REQUEST_TIMEOUT=30

# Firecrawl - Website Content Extraction
# Get your API key from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=
FIRECRAWL_REQUEST_TIMEOUT=60
FIRECRAWL_MAX_PAGES=5

# Search API - Web Search Provider
# Options: SerpAPI, ScrapingBee, etc.
SEARCH_API_PROVIDER=serpapi
SEARCH_API_KEY=
SEARCH_API_TIMEOUT=30

# Security Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Job Configuration
MAX_RESULTS_PER_JOB=500
DEFAULT_SEARCH_RADIUS_KM=10
JOB_TIMEOUT_SECONDS=3600

# Crawler Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=1
MAX_RETRIES=3
USER_AGENT=CRM-Lead-Discovery-Bot/1.0

# SSRF Protection
ALLOW_PRIVATE_IPS=false
BLOCKED_DOMAINS=localhost,127.0.0.1,0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
