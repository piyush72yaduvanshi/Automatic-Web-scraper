# Google Maps Scraper Engine Configuration

# Port the engine serves on (Default: 8080)
SCRAPER_PORT=8080

# Bind host (Default: 0.0.0.0 for server/docker, 127.0.0.1 for local only)
SCRAPER_HOST=0.0.0.0

# Allow remote API/Web calls without localhost restriction (Default: 1 for server)
SCRAPER_ALLOW_REMOTE=1

# Optional API Security Key.
# When set, all incoming API requests must provide header "X-API-Key: <your_secret>"
# Leave blank for open local/private network use.
SCRAPER_API_KEY=

# Headless browser mode (1 = Headless background Chrome, 0 = Visible window)
SCRAPER_HEADLESS=1

# Optional: Path to custom Chrome/Chromium binary
# CHROME=/usr/bin/chromium
