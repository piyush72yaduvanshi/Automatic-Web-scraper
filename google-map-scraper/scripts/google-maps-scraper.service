[Unit]
Description=Google Maps Scraper Engine Microservice
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/google-map-scraper
ExecStart=/usr/bin/python3 engine/serve.py --host 0.0.0.0 --port 8080 --allow-remote
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1
Environment=SCRAPER_PORT=8080
Environment=SCRAPER_ALLOW_REMOTE=1
Environment=SCRAPER_HEADLESS=1

[Install]
WantedBy=multi-user.target
