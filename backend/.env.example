# Application Configuration
APP_NAME="CRM Lead Discovery"
APP_ENV=development  # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration - Change password in production!
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_PASSWORD@localhost:5432/crm_leads
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Provider API Keys (Optional - add your keys for real data)
APIFY_API_TOKEN=your_apify_token_here
APIFY_MAPS_ACTOR_ID=nwua9Gu5YrADL7ZDj
APIFY_REQUEST_TIMEOUT=300

OUTSCRAPER_API_KEY=your_outscraper_key_here
OUTSCRAPER_REQUEST_TIMEOUT=300

GOOGLE_PLACES_API_KEY=your_google_places_key_here
GOOGLE_PLACES_REQUEST_TIMEOUT=30

FIRECRAWL_API_KEY=your_firecrawl_key_here
FIRECRAWL_REQUEST_TIMEOUT=60
FIRECRAWL_MAX_PAGES=5

SEARCH_API_PROVIDER=serpapi
SEARCH_API_KEY=your_search_api_key_here
SEARCH_API_TIMEOUT=30

# AI Intelligence (Optional Gemini / OpenRouter keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=CHANGE_THIS_SECRET_KEY_MINIMUM_32_CHARACTERS
ADMIN_API_KEY=CHANGE_THIS_ADMIN_API_KEY
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
AUTH_ENABLED=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_DISCOVERY=10/minute
RATE_LIMIT_AI_AGENTS=20/minute
RATE_LIMIT_OUTREACH=10/minute
RATE_LIMIT_DEFAULT=60/minute

# Job Configuration
MAX_RESULTS_PER_JOB=500
DEFAULT_SEARCH_RADIUS_KM=10
JOB_TIMEOUT_SECONDS=3600

# Crawler Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_DELAY_SECONDS=1
MAX_RETRIES=3
USER_AGENT=CRM-Lead-Discovery-Bot/1.0

# SSRF Protection
ALLOW_PRIVATE_IPS=false
BLOCKED_DOMAINS=["localhost", "127.0.0.1", "0.0.0.0"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET
MINIO_BUCKET_NAME=crm-assets
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# Social Media Automation (Instagram, Facebook, X, LinkedIn)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_URN=

# Email Configuration
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=crm_whatsapp_verify_token_default
