# ==========================================
# Backend Python & FastAPI .gitignore
# ==========================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.*
!.env.example

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.pyd

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/

# Local databases & test DBs
*.db
*.sqlite
*.sqlite3
test.db

# Logs & temp
*.log
logs/
*.tmp
*.temp
.cache/

# Celery & worker artifacts
celerybeat-schedule
celerybeat.pid

# Playwright browser binaries
.playwright/

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

