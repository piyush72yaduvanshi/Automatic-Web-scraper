# ==========================================
# Frontend React & Vite .gitignore
# ==========================================

# Node dependencies (HUGE, NEVER COMMIT)
node_modules/
.pnpm-store/

# Production build output
dist/
dist-ssr/

# Environment files with potential local API URLs / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Vite & build caches
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

